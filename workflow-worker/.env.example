# =============================================================================
# workflow-worker environment
# Copy to .env and fill in secrets. Every var below is read by WorkerSettings
# (src/workflow_worker/config.py); defaults shown match the code defaults.
# =============================================================================

# --- Worker tuning ----------------------------------------------------------
# Max seconds to sleep when no schedule is due (adaptive sleep cap). > 0
WORKFLOW_WORKER_MAX_SLEEP_SECONDS=30
# Max workflows executing simultaneously per pod. >= 1
WORKFLOW_WORKER_MAX_CONCURRENT_RUNS=5
# Max claimed (queued + running) schedules per pod. Must be >= MAX_CONCURRENT_RUNS
WORKFLOW_WORKER_MAX_CLAIMED_RUNS=10
# Lease/heartbeat duration in seconds. >= 30
WORKFLOW_WORKER_LEASE_DURATION_SECONDS=300

# --- MongoDB ----------------------------------------------------------------
# NOTE: transactions are required (advance_and_insert_run) → Mongo must be a replica set.
MONGO_URI=mongodb://127.0.0.1:27017/jarvis
MONGODB_USERNAME=
MONGODB_PASSWORD=

# --- Redis (cross-pod control queue / cancellation) -------------------------
REDIS_URI=redis://127.0.0.1:6379/1
REDIS_KEY_PREFIX=jarvis-registry

# --- AWS Bedrock (step-node LLM) --------------------------------------------
AWS_WORKFLOW_LLM_MODEL=amazon.nova-2-lite-v1:0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- JWT signing (service-to-service auth for A2A/MCP steps) -----------------
JWT_PRIVATE_KEY=replace_with_pem_private_key
JWT_ISSUER=http://localhost:7860
JWT_SELF_SIGNED_KID=self-signed-key-v1
JWT_AUDIENCE=jarvis-services
REGISTRY_APP_NAME=jarvis-registry-client
