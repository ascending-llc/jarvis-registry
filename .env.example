# =============================================================================
# Jarvis Registry - Environment Configuration Sample
# =============================================================================
# Copy this file to .env and update with your actual values
# Never commit real credentials to version control

# =============================================================================
# REGISTRY CONFIGURATION
# =============================================================================

# Public URL where the Jarvis Registry is accessible
# For custom HTTPS domain: https://mcpgateway.mycorp.com
REGISTRY_URL=http://localhost:7860

# Identifies this deployment in application logic and telemetry.
DEPLOYMENT_ENVIRONMENT=local

# =============================================================================
# AUTH SERVER CONFIGURATION
# =============================================================================

# Internal auth server URL (for Docker network communication)
AUTH_SERVER_URL=http://auth-server:8888

# External auth server URL (public-facing)
# For custom HTTPS domain: https://mcpgateway.mycorp.com
AUTH_SERVER_EXTERNAL_URL=https://your-domain.com

# Frontend client URL (for browser access to the registry frontend)
REGISTRY_CLIENT_URL=http://localhost

# client_id and client_secret of Registry as an OAuth client of Auth Server
REGISTRY_APP_NAME=registry-client
REGISTRY_CLIENT_SECRET=use-64-char-random-hex-string

# =============================================================================
# MONGODB CONFIGURATION
# =============================================================================

# MongoDB connection URI
# Format: mongodb://[username]:[password]@[host]:[port]/[database]?options
# docker-compose.yml overrides MONGO_URI on each service to use the bundled registry-mongodb
# container, so this value applies only when running services outside Compose.
# directConnection=true is needed from the host: the replica set advertises its in-network hostname.
# For Docker host access: mongodb://host.docker.internal:27017/jarvis?directConnection=true
MONGO_URI=mongodb://localhost:27017/jarvis?directConnection=true

# Encryption key for encrypting sensitive credentials in the database
CREDS_KEY=your_secure_creds_key_for_encrypting_tokens

# =============================================================================
# OPENTELEMETRY
# =============================================================================
# Override when telemetry is sent to an external collector. Compose defaults to http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Controls Agno-generated child spans; Workflow root input/output is always recorded.
# Set both to false to display Agno Workflow and Step input/output in Langfuse.
OTEL_TRACE_HIDE_INPUTS=true
OTEL_TRACE_HIDE_OUTPUTS=true

# =============================================================================
# AUTHENTICATION PROVIDER CONFIGURATION
# =============================================================================
# Choose authentication provider: 'entra' or 'google'
AUTH_PROVIDER=entra

# =============================================================================
# MICROSOFT ENTRA ID (AZURE AD) OAUTH2 CONFIGURATION (if AUTH_PROVIDER=entra)
# =============================================================================

# Microsoft Entra ID Tenant ID
# Get this from Azure Portal > Azure Active Directory > Overview > Tenant ID
# Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Or use special values:
#   - 'common': Multi-tenant (any organizational or personal Microsoft account)
#   - 'organizations': Multi-tenant (organizational accounts only)
#   - 'consumers': Personal Microsoft accounts only
ENTRA_TENANT_ID=your_tenant_id_here

# Azure AD Application (Client) ID
# Get this from Azure Portal > App Registrations > Your App > Overview > Application (client) ID
# Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_CLIENT_ID=your_application_client_id_here

# Azure AD Client Secret
# Get this from Azure Portal > App Registrations > Your App > Certificates & secrets > Client secrets
# IMPORTANT: Copy the SECRET VALUE, not the Secret ID
# Format: xxx~xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ENTRA_CLIENT_SECRET=your_client_secret_value_here

# Bind the four scope groups to Entra Object IDs, not display names.
# Left empty on purpose: Entra startup fails until all four are set to your tenant's group Object IDs.
# Google-only deployments (ENTRA_ENABLED=false) leave them empty.
# Required on registry, auth-server and workflow-worker for Entra deployments.
# auth-server also requires them whenever ENTRA_ENABLED=true (the default).
# Setup and verification: docs/runbooks/entra-scope-groups.md
JARVIS_REGISTRY_ADMIN_GROUP_OBJECT_ID=
JARVIS_REGISTRY_POWER_USER_GROUP_OBJECT_ID=
JARVIS_REGISTRY_USER_GROUP_OBJECT_ID=
JARVIS_REGISTRY_READ_ONLY_GROUP_OBJECT_ID=


# Entra ID specific claim mapping
# Set to determine which user info property returned from OpenID Provider to store as the User's username
ENTRA_USERNAME_CLAIM=preferred_username

# Set to determine which group attribute returned from OpenID Provider to filter for group permission
ENTRA_GROUPS_CLAIM=groups

# Set to determine which user info property returned from OpenID Provider to store as the User's name
ENTRA_NAME_CLAIM=name

# Microsoft Graph API Base URL
# Used for checking configured scope-group membership
#ENTRA_GRAPH_URL=https://graph.microsoft.com

# M2M (Machine-to-Machine) Default Scope
#ENTRA_M2M_SCOPE=https://graph.microsoft.com/.default

# Show the Entra button on the login page (default: true)
# ENTRA_ENABLED=true

# =============================================================================
# GOOGLE WORKSPACE OAUTH2 CONFIGURATION (if AUTH_PROVIDER=google or GOOGLE_ENABLED=true)
# =============================================================================

# Google OAuth 2.0 client credentials
# Get these from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Workspace domain, required for Google group scope grants. Only groups on this exact
# domain grant scopes. Also restricts the verified account's `hd` claim and account picker.
# When empty, no Google group grants scopes.
# GOOGLE_ALLOWED_HD=yourcompany.com

# Workspace customer ID (starts with "C"). Limits group lookups to groups owned by this Workspace.
# Without it, Google rejects the lookup for any user who also belongs to a group owned by another
# organization (e.g. a public @googlegroups.com list), and that user gets no groups or scopes.
# Find it in Admin Console > Account > Account settings, or as the "owner: customers/C..." line
# printed by scripts/diagnose_google_groups.py.
# GOOGLE_CUSTOMER_ID=C0xxxxxxx

# Service account key JSON for resolving Google group memberships via the Cloud Identity API.
# Google does not put groups in the id_token, so this is required for group->scope mapping.
# Paste the raw JSON key content (single line). Without it, no groups or scopes are resolved.
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}

# Show the Google button on the login page (default: false)
# GOOGLE_ENABLED=false

# =============================================================================
# APPLICATION SECURITY
# =============================================================================

# CRITICAL: CHANGE THIS SECRET KEY IMMEDIATELY!
# This is used for JWT token signing temp cookies OAuth init and OAuth callback
# Generate a strong, random 64-character string in production
# WARNING: Using the default value is a security risk!
SECRET_KEY=CHANGE-THIS-IMMEDIATELY-use-a-strong-random-key-in-production
# Key to Generate Asymmetric JWT Keys (if using RSA/ECDSA for JWT signing)
JWT_PRIVATE_KEY=replace_with_pem_private_key
JWT_PUBLIC_KEY=replace_with_pem_public_key
# `kid` header for self-signed JWKS lookup; default is self-signed-key-v1
JWT_SELF_SIGNED_KID=self-signed-key-v1
# Outbound / service-to-service audience (registry/workflow-worker -> external MCP / AgentCore Runtime)
JWT_AUDIENCE=jarvis-services

# =============================================================================
# SESSION COOKIE CONFIGURATION
# =============================================================================

# Session cookie secure flag (HTTPS-only transmission)
# IMPORTANT: Set based on your environment:
#   - Local development (localhost via HTTP): Set to false
#   - Production with HTTPS: Set to true
#
# If set to true, cookies will ONLY be sent over HTTPS connections.
# Setting this to true on localhost (HTTP) will cause login to fail!
#
# Default: false (safe for local development)
# Production: MUST be true
SESSION_COOKIE_SECURE=false

# Session cookie domain (for cross-subdomain authentication)
# Leave unset or empty for single-domain deployments (RECOMMENDED for most cases)
# Set to domain with leading dot for cross-subdomain sharing
#
# Examples:
#   Single domain (mcpgateway.ddns.net): Leave unset or set to empty string
#     SESSION_COOKIE_DOMAIN=
#
#   Cross-subdomain (auth.example.com + registry.example.com): Set to .example.com
#     SESSION_COOKIE_DOMAIN=.example.com
#
#   Multi-level domains (registry.region-1.corp.company.internal): Set to your org domain
#     SESSION_COOKIE_DOMAIN=.corp.company.internal
#
# Default: Empty (cookie scoped to exact host only - safest option)
SESSION_COOKIE_DOMAIN=

# =============================================================================
# Registry MCPGW Service TRANSPORT SECURITY
# =============================================================================

# Enable DNS rebinding protection for MCP Gateway endpoints
# Protects against DNS rebinding attacks by validating Host and Origin headers
# Set to false during local development if needed, true for production (recommended)
MCPGW_ENABLE_DNS_REBINDING_PROTECTION=true

# Comma-separated list of allowed Host header values for MCP Gateway endpoints
# Include both with and without ports (e.g., 127.0.0.1 for implicit port, 127.0.0.1:* for explicit ports)
# Supports wildcard port patterns using :* (e.g., 127.0.0.1:* allows any port on 127.0.0.1)
# Local development default includes localhost, 127.0.0.1, and IPv6 loopback
# For production, restrict to your actual domain(s)
MCPGW_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,[::1],[::1]:*

# Comma-separated list of allowed Origin header values for MCP Gateway endpoints
# Include both with and without ports (e.g., http://127.0.0.1 for implicit port 80)
# Supports wildcard port patterns using :* (e.g., http://127.0.0.1:* allows any port)
# Must match the protocol (http/https) and host
# For production, add your actual domain(s): https://mcpgateway.mycorp.com
MCPGW_ALLOWED_ORIGINS=http://127.0.0.1,http://127.0.0.1:*,http://localhost,http://localhost:*,http://[::1],http://[::1]:*

# Kill switch for the 2026-07-28 MCP protocol era on the gateway. Set false only to roll back: a
# request asking for 2026-07-28 is then rejected with a JSON-RPC -32022 so SDK clients fall back
# to 2025-11-25.
MCPGW_MODERN_PROTOCOL_ENABLED=true

# =============================================================================
# MCP REGISTRY (GitHub-compatible v0.1 catalog)
# =============================================================================
ENABLE_MCP_REGISTRY=false

# Reverse-DNS namespace prefixed to every catalog entry's `name` (ASCENDING's, not the client's).
MCP_REGISTRY_NAMESPACE=com.ascendingdc.jarvis

# Pagination for GET /v0.1/servers (mirrors the official registry: default 30, max 100).
MCP_REGISTRY_DEFAULT_LIMIT=30
MCP_REGISTRY_MAX_LIMIT=100

# =============================================================================
# EMBEDDINGS CONFIGURATION
# =============================================================================

# These settings are only used when TOOL_DISCOVERY_MODE=embedded.
# They configure the local sentence-transformers model used by EmbeddedFaissService.

# Model name for local FAISS embeddings generation.
# Uses a sentence-transformers model from Hugging Face.
LOCAL_EMBEDDINGS_MODEL_NAME=all-MiniLM-L6-v2

# Embedding dimension (must match the model's output dimension)
# Example: all-MiniLM-L6-v2 -> 384
LOCAL_EMBEDDINGS_MODEL_DIMENSIONS=384

# =============================================================================
# AZURE OPENAI EMBEDDINGS CONFIGURATION
# =============================================================================
# IMPORTANT: When using EMBEDDINGS_PROVIDER=azure_openai, you MUST set:
#   - AZURE_OPENAI_API_KEY (required)
#   - AZURE_OPENAI_ENDPOINT (required)
#   - AZURE_OPENAI_EMBEDDING_DEPLOYMENT (required)
# Failure to set these will cause the application to fail on startup.

# Azure OpenAI API key for embeddings
# Get this from Azure Portal > Your OpenAI Resource > Keys and Endpoint
# AZURE_OPENAI_API_KEY=<AZURE_OPENAI_API_KEY>

# Azure OpenAI endpoint URL
# Format: https://<your-resource-name>.openai.azure.com/
# Get this from Azure Portal > Your OpenAI Resource > Keys and Endpoint
# AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com/

# Azure OpenAI API version
# Recommended: 2024-06-01 (or latest stable version)
# Check https://learn.microsoft.com/en-us/azure/ai-services/openai/reference for versions
# AZURE_OPENAI_API_VERSION=2024-06-01

# Azure OpenAI resource name (the name of your Azure OpenAI resource)
# Example: jarvis-foundry-test-eastus-01
# AZURE_OPENAI_RESOURCE_NAME=<AZURE_OPENAI_RESOURCE_NAME>

# Azure OpenAI deployment name for embeddings
# This is the name you gave when deploying the embedding model in Azure
# Example: jarvis-embedding, text-embedding-ada-002
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<AZURE_OPENAI_EMBEDDING_DEPLOYMENT>

# =============================================================================
# ADDITIONAL CONFIGURATION
# =============================================================================

# Optional: Additional service-specific environment variables
# Add any additional configuration variables your deployment requires

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection URI for caching and session management
REDIS_URI=redis://registry-redis:6379/1

# Redis key prefix to namespace registry keys
# Used to avoid key collisions in shared Redis instances
REDIS_KEY_PREFIX=jarvis-registry

# Redis key prefix auth-server uses for its OAuth client and consent stores.
# Registry and auth-server must use this same shared namespace.
AUTH_SERVER_REDIS_KEY_PREFIX=jarvis-auth-server

# =============================================================================
# WORKFLOW WORKER CONFIGURATION
# =============================================================================

# Max seconds to sleep when no schedule is due (adaptive sleep cap). > 0
WORKFLOW_WORKER_MAX_SLEEP_SECONDS=30
# Max workflows executing simultaneously per pod. >= 1
WORKFLOW_WORKER_MAX_CONCURRENT_RUNS=5
# Max claimed (queued + running) schedules per pod. Must be >= MAX_CONCURRENT_RUNS
WORKFLOW_WORKER_MAX_CLAIMED_RUNS=10
# Lease/heartbeat duration in seconds. >= 30
WORKFLOW_WORKER_LEASE_DURATION_SECONDS=300

# =============================================================================
# WEAVIATE VECTOR DATABASE CONFIGURATION
# =============================================================================

# Enable API key authentication for Weaviate
# Set to true to require API keys for Weaviate access
AUTHENTICATION_APIKEY_ENABLED=true

# Comma-separated list of API keys allowed to access Weaviate
# These keys correspond to the users defined in AUTHENTICATION_APIKEY_USERS
AUTHENTICATION_APIKEY_ALLOWED_KEYS=test-secret-key,test2-secret-key

# Comma-separated list of users for API key authentication
# Must match the order of keys in AUTHENTICATION_APIKEY_ALLOWED_KEYS
AUTHENTICATION_APIKEY_USERS=test,test2

# Enable authorization with admin list
# Set to true to enable role-based access control
AUTHORIZATION_ADMINLIST_ENABLED=true

# Comma-separated list of admin users (full read/write access)
AUTHORIZATION_ADMINLIST_USERS=test

# Comma-separated list of read-only users (query-only access)
AUTHORIZATION_ADMINLIST_READONLY_USERS=test2

# Comma-separated list of enabled Weaviate modules
# Available modules:
#   - text2vec-openai: OpenAI embeddings integration
#   - text2vec-aws: AWS Bedrock embeddings integration
ENABLE_MODULES=text2vec-openai,text2vec-aws

# Optional: OpenAI API key for text2vec-openai module
# Uncomment and set if using OpenAI embeddings
# OPENAI_APIKEY=${RAG_OPENAI_API_KEY}

# Optional: Weaviate advanced settings (uncomment to customize)
# CLIP_INFERENCE_API=http://multi2vec-clip:8080
# CLUSTER_HOSTNAME=node1
# PERSISTENCE_DATA_PATH=/var/lib/weaviate
# QUERY_DEFAULTS_LIMIT=25
# QUERY_MAXIMUM_RESULTS=10000

# Weaviate log level (debug, info, warning, error)
LOG_LEVEL=info

# Enable automatic schema creation
# Set to true to allow Weaviate to auto-create classes/schemas
ENABLE_AUTO_SCHEMA=true

# =============================================================================
# WEAVIATE CONNECTION SETTINGS
# =============================================================================

# Weaviate host address
# For Docker network: weaviate
# For local development: localhost
WEAVIATE_HOST=weaviate

# Weaviate port number (default: 8080)
WEAVIATE_PORT=8080

# API key for registry to authenticate with Weaviate
# Must match one of the keys in AUTHENTICATION_APIKEY_ALLOWED_KEYS
WEAVIATE_API_KEY=test-secret-key

# =============================================================================
# VECTOR EMBEDDINGS AND SEARCH CONFIGURATION
# =============================================================================

# These settings are only used when TOOL_DISCOVERY_MODE=external.

# Embeddings provider for vector search
# Options: 'aws_bedrock', 'openai', 'azure_openai'
# Default: aws_bedrock
EMBEDDING_PROVIDER=aws_bedrock

# Vector store backend
# Options: 'weaviate'
# Default: weaviate
VECTOR_STORE_TYPE=weaviate

# For AWS Bedrock: amazon.titan-embed-text-v2:0, amazon.titan-embed-text-v1
# For OpenAI: text-embedding-3-small, text-embedding-3-large
# For Azure OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Reranking (AWS Bedrock Cohere Rerank). Runs as a remote Bedrock API call —
# uses the AWS_REGION / AWS_* credentials below (or the default credential chain).
# Set RERANK_ENABLED=false to skip reranking and return raw vector-search order.
RERANK_ENABLED=true
RERANK_MODEL_ID=cohere.rerank-v3-5:0

# =============================================================================
# AWS BEDROCK CONFIGURATION (for embeddings)
# =============================================================================

# These settings are used when TOOL_DISCOVERY_MODE=external and EMBEDDING_PROVIDER=aws_bedrock.

# AWS credentials for Amazon Bedrock access
# Note: For production, use IAM roles instead of credentials
# Leave empty to use default AWS credential chain (recommended)
# For local development or testing, set these credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS region for Bedrock service
# Common regions: us-east-1, us-west-2, eu-west-1
AWS_REGION=us-east-1

# Max characters a compiled workflow step prompt (goal + dependencies + trigger params, as a whole)
# may reach before being truncated. Sized for the default workflow model's context window
# (currently Claude Sonnet 5, 1M tokens) — ~900,000 tokens of budget at a ~4 chars/token estimate,
# leaving headroom for the rest of the request and the model's response.
# Default: 3600000
# WORKFLOW_PROMPT_MAX_CHARS=3600000

# =============================================================================
# OPENAI EMBEDDINGS CONFIGURATION
# =============================================================================

# These settings are used when TOOL_DISCOVERY_MODE=external and EMBEDDING_PROVIDER=openai.

# OpenAI API key for embeddings
# Required when EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# OpenAI embedding model
# Optional when EMBEDDING_PROVIDER=openai
# Default: text-embedding-3-small
# OPENAI_MODEL=text-embedding-3-small

# =============================================================================
# TOOL DISCOVERY CONFIGURATION
# =============================================================================

# Tool discovery mode for MCP servers
# Options:
#   - 'embedded': Use built-in tool discovery (MCP client connects directly)
#   - 'external': Use external vector search service (Weaviate)
# Default: external (recommended for production)
# Note: External mode provides better search capabilities and caching
TOOL_DISCOVERY_MODE=external
